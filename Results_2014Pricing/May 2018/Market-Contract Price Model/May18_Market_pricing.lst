      - Revenue(Hydropeak,Sunday,pHigh) - Revenue(Hydropeak,Saturday,pLow)
     
      - Revenue(Hydropeak,Saturday,pHigh) - Revenue(Hydropeak,Weekday,pLow)
     
      - Revenue(Hydropeak,Weekday,pHigh) =E= 0 ;
     
