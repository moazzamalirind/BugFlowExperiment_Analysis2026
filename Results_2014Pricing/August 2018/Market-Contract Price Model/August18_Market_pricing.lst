 162  *===============================================
 163  SCALAR
 164  Convert                        Conversion factor from cfs to ac-ft per hou
      r (0.0014*60)/0.083/
 165  Daily_RelRange                 Allowable daily release range (cfs)/8000/
 166   
 167  Totaldays                      Total number of days in the month/31/
 168  Nu_Saturdays                   Number of saturdays in the month/4/
 169  Nu_Sun_Holi                    Number of sundays + holidays in the month /
      4/
 170  *Here we are considering an arbitrary monthly calender with exact number o
      f days as in real month but that considered month starts on monday.
 171  *Which means there will be 4 Saturdays and 4 Sundays in the month. We are 
      considering any holidays in the month.
 172  *The real monthly calender can be easily used by changing the number of da
      ys of each day type, if required.
 173  *===============================================
 174  VARIABLES
 175   
 176  ObjectiveVal                    Objective functions value ($)
 177  storage                         Reservoir storage at the end of the month 
      (acre-ft)
 178  Released_vol                    Total water released during the month (ac-
      ft)
 179   
 180  Revenue_zeroSteadyFlow          Revenue genereated from all flowpatterns d
      aytypes and periods when zero number of steady low flow day($)
 181   
 182  Positive Variables
 183   
 184  Revenue(FlowPattern,d,p)        Revenue all ($)
 185   
 186  Release(FlowPattern,d,p)        Reservoir release on different day types a
      nd flow patterns durinng period p (cfs)
 187  Energy_Gen(FlowPattern,d,p)     Hydropower Generated within each timestep 
      during different day types(MWh)
 188   
 189  ;
 190  *===============================================
 191   
 192  EQUATIONS
 193   
 194  *Constraints
 195  EQ1_ResMassBal                                   Reservoir mass balance (a
      cre-ft)
 196  EQ2_reqpowerstorage                              The minimum storage requi
      red for hydropower generation(power pool storage) (acre-ft)
 197  EQ3_maxstor                                      Reservoir Max storage (ac
      re-ft)
 198  EQ4_MaxR(FlowPattern,d,p)                        Max Release for any day t
      ype during any period p but it will not work when NumDays will be zero(cfs
      )
 199  EQ5_MinR(FlowPattern,d,p)                        Min Release for any day t
      ype with flows during any period p but it will not work when NumDays will 
      be zero (cfs)
 200  EQ6_ZeroFlowDays(FlowPattern,d,p)                No release for any day ty
      pe during any period p when Num_Days equal to zero(cfs)
 201  EQ7_Rel_Range(FlowPattern,d)                     Constraining the daily re
      lease range but it will not work when NumDays will be zero(cfs per day)
 202  EQ8_AlternativeDays_Relrange                     Constraining release chan
      ge between on-peak of current day and off-peak of next day to be less than
       or equal to 8000 (cfs)
 203  EQ9_AlternativeDays_Relrange                     Constraining release chan
      ge between on-peak of current day and off-peak of next day to be less than
       or equal to 8000 (cfs)
 204  EQ10_AlternativeDays_Relrange                    Constraining release chan
      ge between on-peak of current day and off-peak of next day to be less than
       or equal to 8000 (cfs)
 205   
 206  EQ11_Monthtlyrel                                 Constraining total monthl
      y release volume (ac-ft)
 207  EQ12_RelVolume                                   Total volume from differe
      nt types of day in the month (ac-ft)
 208   
 209  EQ13_SteadyFlow_Day(d)                           Constraining on-peak and 
      off-peak releases during Steadyflow day to be equal (cfs)
 210  EQ14_OffsetRel                                   Offset release between of
      f-peak unsteady weekday and off-peak steady weekend (saturday or and sunda
      y)releses(cfs)
 211   
 212   
 213  EQ15_OnPeak_Saturday                             On-peak Saturday constrai
      nt. i.e. Weekend on-peak minus 2000 cfs (found this value from observed hy
      drographs of 2015 2016 2017).
 214  EQ15a_offpeak_Saturday                           Off-peak Saturday constra
      int (cfs)
 215   
 216  EQ16_OnPeak_Sunday                               On-peak Sunday constraint
      . i.e.  equal to Saturday On-peak.
 217  EQ16a_offpeak_Sunday                             Off-peak Sunday constrain
      t (cfs)
 218   
 219   
 220  EQ17_Steady_Saturdays(p)                         Constraining the steady S
      aturday flows equal to steady sundays flows (cfs)
 221   
 222  ** here I am assuming that steady weekday equals to steady sundays.
 223  EQ18_Steady_Weekdays(p)                          Constraining the steady w
      eekdays flows equal to steady sundays flows (cfs)
 224   
 225  EQ19_OnPeak_UnsteadyDay(d)                       Constraining on-peak unst
      eady day release to be greater than off-peak unsteady release on the same 
      day (cfs)
 226   
 227   
 228  EQ20_EnergyGen_Max(FlowPattern,d,p)              Maximum Energy Generation
       Limit of the Glen Caynon Dam(MW)
 229  EQ21_EnergyGen(FlowPattern,d,p)                  Energy generated in each 
      period p during different day types (MWh)
 230   
 231  ;
 232   
 233   
 234   
 235  *-------------------------------------------------------------------------
      -----*
 236   
 237  *Mass Balance Equation
 238  EQ1_ResMassBal..                               storage =e= Initstorage + (
      Inflow*Convert*sum(p,Duration(p))*Totaldays)- Released_vol - evap;
 239  *                                                                         
       CFS * conversion factor from cfs to ac-ft/hr and multiplied by 24 (total 
      duration in a day) then multiplied by total day in the month
 240  *=======================Physical Constraints==============================
      =======
 241  EQ2_reqpowerstorage..                          storage =g= minstorage;
 242  EQ3_maxstor..                                  storage =l= maxstorage;
 243   
 244  EQ4_MaxR(FlowPattern,d,p)$(Num_Days(FlowPattern,d) gt 0)..                
           Release(FlowPattern,d,p)=l= maxRel;
 245   
 246  EQ5_MinR(FlowPattern,d,p)$(Num_Days(FlowPattern,d) gt 0)..                
           Release(FlowPattern,d,p)=g= minRel;
 247   
 248  EQ6_ZeroFlowDays(FlowPattern,d,p)$(Num_Days(FlowPattern,d) eq 0)..        
           Release(FlowPattern,d,p)=e=0;
 249   
 250  EQ7_Rel_Range(FlowPattern,d)$(Num_Days(FlowPattern,d) gt 0)..             
           Release(FlowPattern,d,"pHigh")- Release(FlowPattern,d,"pLow")=l=Daily
      _RelRange;
 251   
 252  EQ8_AlternativeDays_Relrange$(Num_days("HydroPeak","Sunday") gt 0)..      
           Release("HydroPeak","Saturday","pHigh")- Release("HydroPeak","Sunday"
      ,"pLow")=l=Daily_RelRange;
 253  EQ9_AlternativeDays_Relrange$(Num_days("HydroPeak","Saturday") gt 0) ..   
           Release("HydroPeak","Weekday","pHigh")- Release("HydroPeak","Saturday
      ","pLow")=l=Daily_RelRange;
 254  EQ10_AlternativeDays_Relrange$(Num_days("HydroPeak","Sunday") gt 0)..     
           Release("HydroPeak","Sunday","pHigh")- Release("HydroPeak","Weekday",
      "pLow")=l=Daily_RelRange;
 255   
 256   
 257  *EQ11_  constraining the overall monthly released volume..
 258  EQ11_Monthtlyrel..                                                        
            TotMonth_volume=e= Released_vol;
 259   
 260  EQ12_RelVolume..                                                          
            Released_vol=e= sum(FlowPattern,sum(d, sum(p, Release(FlowPattern,d,
      p)*Convert*Duration(p))*Num_Days(FlowPattern,d)));
 261   
 262  *======================Managerial Constraints=============================
      ======================
 263   
 264  EQ13_SteadyFlow_Day(d)$(Num_days("Steady","Sunday") gt 0)..               
                   Release("Steady",d,"pHigh") =e= Release("Steady",d,"pLow");
 265   
 266  * EQ14_  finds the minimimum release value from the hydrograph plus additi
      onal release we desire on weekends above off-peak weekday release (i.e. Of
      fset).
 267   
 268  EQ14_OffsetRel$((Num_days("HydroPeak","Weekday") gt 0) and (Num_Days("Stea
      dy","Sunday") gt 0))..            Release("Steady","Sunday","pLow")=e= Rel
      ease("HydroPeak","Weekday","pLow")+ Weekend_Rel;
 269   
 270  EQ15_OnPeak_Saturday$(Num_days("HydroPeak","Saturday") gt 0)..            
                         Release("HydroPeak","Saturday","pHigh")=e= Release("Hyd
      roPeak","Weekday","pHigh")-2000;
 271  EQ15a_offpeak_Saturday$(Num_days("HydroPeak","Saturday") gt 0)..          
                         Release("HydroPeak","Saturday","pLow")=e=  Release("Hyd
      roPeak","Weekday","pLow");
 272   
 273   
 274  EQ16_OnPeak_Sunday$(Num_days("HydroPeak","Sunday") gt 0)..                
             Release("HydroPeak","Sunday","pHigh")=e= Release("HydroPeak","Weekd
      ay","pHigh")-2000;
 275  EQ16a_offpeak_Sunday$(Num_days("HydroPeak","Sunday") gt 0)..              
             Release("HydroPeak","Sunday","pLow")=e= Release("HydroPeak","Weekda
      y","pLow");
 276   
 277  EQ17_Steady_Saturdays(p)$(Num_Days("Steady","Saturday")gt 0)..            
             Release("Steady","Saturday",p)=e= Release("Steady","Sunday",p);
 278   
 279  ** Eq 18 assumes that steady weekday equals the steady sunday releases.
 280  EQ18_Steady_Weekdays(p)$(Num_Days("Steady","Weekday")gt 0)..              
             Release("Steady","Weekday",p)=e= Release("Steady","Sunday",p);
 281   
 282  EQ19_OnPeak_UnsteadyDay(d)$(Num_Days("HydroPeak",d)gt 0)..                
             Release("HydroPeak",d,"pHigh")=g= Release("HydroPeak",d,"pLow");
 283   
 284  EQ20_EnergyGen_Max(FlowPattern,d,p)..                                     
             Energy_Gen(FlowPattern,d,p)=l= 1320*Duration(p);
 285  *Maximum Energy Generation capacity of GCD (MWH).. Source https://www.usbr
      .gov/uc/rm/crsp/gc
 286  EQ21_EnergyGen(FlowPattern,d,p)..                                         
             Energy_Gen(FlowPattern,d,p)=e= Release(FlowPattern,d,p)*Duration(p)
      *0.03715;
 287  * Energy generation formula used in WAPA Execl model..
 288   
 289  *+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
      ++++++++++++
 290  * Model for Zero steady Low flow day scenario.
 291   
 292  Equation
 293  EQ27_ZeroBugDays_Revenue                         Revenue generated from al
      l flowpatterns daytypes and periods with zero steady low flow days($)
 294  ;
 295   
 296  EQ27_ZeroBugDays_Revenue$(Num_Days("Steady","Sunday") eq 0)..            R
      evenue_zeroSteadyFlow =e= sum(FlowPattern,sum(d, sum(p,Energy_Gen(FlowPatt
      ern,d,p)*Energy_Price(d,"Contract",p))*Num_Days(FlowPattern,d)));
 297   
 298   
 299  *-------------------------------------------------------------------------
      -----*
 300   
 301  MODEL Model0 Find value of hydropower revenue at zero steady flow days usi
      ng LP/ALL/;
 302  *MODEL Model0 Find value of hydropower revenue at zero steady flow days us
      ing LP/EQ1_ResMassBal,EQ2_reqpowerstorage,EQ3_maxstor,EQ4_MaxR,EQ5_MinR,EQ
      6_ZeroFlowDays,
 303  *EQ7_Rel_Range,EQ8_AlternativeDays_Relrange,EQ9_AlternativeDays_Relrange,E
      Q10_AlternativeDays_Relrange,EQ11_Monthtlyrel,EQ12_RelVolume,EQ13_SteadyFl
      ow_Day,
 304  *EQ14_OffsetRel,EQ15_OnPeak_Saturday,EQ15a_offpeak_Saturday,EQ16_OnPeak_Su
      nday,EQ16a_offpeak_Sunday,EQ17_Steady_Saturdays,EQ18_Steady_Weekdays,
 305  *EQ19_OnPeak_UnsteadyDay,EQ20_EnergyGen_Max,EQ21_EnergyGen,EQ27_ZeroBugDay
      s_Revenue/;
 306  *This model is for zero steady low flow days only
 307   
 308   
 309  Num_Days(FlowType,Days)= Days_Distribution(FlowType,Days,"Case1")+ EPS;
 310   
 311  Loop((Offset,tot_vol),
 312  *Loop((Offset,tot_vol)$((ord(Offset) eq 1) and (ord(tot_vol) eq 1)),
 313   
 314  Weekend_Rel= Diff_Release(Offset);
 315  TotMonth_volume = Vol_monthlyrelease(tot_vol);
 316  *Observed_Rel(Days,p)= Nobugflow_Rel(tot_vol,Days,p);
 317  *addded this above line
 318   
 319  option LP= CPLEX;
 320   
 321  Solve Model0 using LP MAXIMIZE Revenue_zeroSteadyFlow;
 322   
 323   
 324  * All the following lines of code are saving values for different paramete
      rs
 325    FStore(Offset,tot_vol,"Case1")=Revenue_zeroSteadyFlow.L;
 326   
 327  * XStore store the energy generated (Mwh/day) during different types of da
      ys
 328     XStore(Offset,tot_vol,"Case1",FlowType,Days)= sum (p,Energy_Gen.L(FlowT
      ype,Days,p))+ EPS;
 329   
 330  * RStore store the reservoir releases (cfs) during different types of days
       and scenarios.
 331     RStore(Offset,tot_vol,"Case1",FlowType,Days,p)= Release.L(FlowType,Days
      ,p)+ EPS;
 332   
 333  *Sstore store the end of month reservoir storage (ac-ft)
 334     Sstore(Offset,tot_vol,"Case1")= storage.L;
 335   
 336   
 337  *Saving the model status for different scenarios.
 338     ModelResults(Offset,tot_vol,"Case1","SolStat")= Model0.solvestat;
 339     ModelResults(Offset,tot_vol,"Case1","ModStat")= Model0.modelstat;
 340  );
 341   
 342  **  Observed releases are considered as baseline to calculate surplus and 
      deficit energy in the Market-Contract model
 343   
 344  *PARAMETER FlowAtZeroSteadyDays(FlowType,Days,p) ;     This paramater is r
      equired incase we are considering modeled releases of unsteady hydrograph 
      as a baseline for market price calculations.
 345   
 346   
 347  ************************************* Additional Equations for market mode
      l
 348  EQUATIONS
 349  *Objective Functions
 350   
 351  EQ22a_Unsteady_days_Onpeak                       Revenue generated during 
      on-peak unsteady Days ($).  For all scenarios except hydropeaking hydrogra
      ph--Zero Steady low flow days and for all steady low flow days.
 352  EQ22b_Unsteady_days_Offpeak                      Revenue generated during 
      on-peak unsteady Days ($).  For all scenarios except hydropeaking hydrogra
      ph--Zero Steady low flow days and for all steady low flow days
 353   
 354  EQ23_Equation(d,p)                               To tackle Unbounded ray e
      rror in case of flat hydrograph
 355  EQ24_Steadydays_Onpeak                           Revenue generated during 
      on-peak Steadyday ($).
 356  EQ25_Steadydays_Offpeak                          Revenue generated during 
      off-peak Steadyday ($)
 357  EQ26_TotalRevenue                                Total monthly Hydropower 
      Revenue generated($). The revenue has all daytypes and all flowpatterns wi
      th both market and contract prices.
 358  ;
 359   
 360   
 361   
 362  *==============================Objective Function=========================
      =============
 363  *EQ22_Unsteady_days(d,p)$((Num_Days("Steady","Sunday") gt 0)and(Num_Days("
      Hydropeak","Weekday") gt 0))..          Revenue("HydroPeak",d,p)=e= [{Flow
      AtZeroSteadyDays("HydroPeak",d,p)* Energy_Price(d,"Contract",p)+ (Release(
      "HydroPeak",d,p)- FlowAtZeroSteadyDays("HydroPeak",d,p))*Energy_Price(d,"M
      arket",p)}*0.03715*Duration(p)]* Num_Days("HydroPeak",d);
 364   
 365  EQ22a_Unsteady_days_Onpeak(d)$((Num_Days("Steady","Sunday") gt 0)and(Num_D
      ays("Hydropeak","Weekday") gt 0))..          Revenue("HydroPeak",d,"pHigh"
      )=e= [{Observed_Rel(d,"pHigh")*Energy_Price(d,"Contract","pHigh") + (Relea
      se("HydroPeak",d,"pHigh")- Observed_Rel(d,"pHigh"))*Energy_Price(d,"Market
      ","pHigh")}*0.03715*Duration("pHigh")]* Num_Days("HydroPeak",d);
 366  EQ22b_Unsteady_days_Offpeak(d)$((Num_Days("Steady","Sunday") gt 0)and(Num_
      Days("Hydropeak","Weekday") gt 0))..          Revenue("HydroPeak",d,"pLow"
      )=e= [{Release("HydroPeak",d,"pLow")*Energy_Price(d,"Contract","pLow") - (
      Observed_Rel(d,"pLow")- Release("HydroPeak",d,"pLow"))*Energy_Price(d,"Mar
      ket","pLow")}*0.03715*Duration("pLow")]* Num_Days("HydroPeak",d);
 367   
 368   
 369  EQ23_Equation(d,p)$(Num_Days("Hydropeak","Weekday") eq 0)..               
                 Revenue("HydroPeak",d,p)=e=0;
 370   
 371  EQ24_Steadydays_Onpeak(d)$(Num_Days("Steady","Sunday") gt 0)..         Rev
      enue("Steady",d,"pHigh")=e=  [{Release("Steady",d,"pHigh")* Energy_Price(d
      ,"Contract","pHigh")-[(Observed_Rel(d,"pHigh")-Release("Steady",d,"pHigh")
      )*Energy_Price(d,"Market","pHigh")]}*Duration("pHigh")*0.03715]* Num_Days(
      "Steady",d);
 372  ****EQ24_Steadydays_Onpeak(d)$(Num_Days("Steady","Sunday") gt 0)..        
       Revenue("Steady",d,"pHigh")=e=  [{Release("Steady",d,"pHigh")* Energy_Pri
      ce(d,"Contract","pHigh")-(FlowAtZeroSteadyDays("Steady",d,"pHigh")-Release
      ("Steady",d,"pHigh"))*Energy_Price(d,"Market","pHigh")}*Duration("pHigh")*
      0.03715]* Num_Days("Steady",d);
 373  EQ25_Steadydays_Offpeak(d)$(Num_Days("Steady","Sunday") gt 0)..        Rev
      enue("Steady",d,"pLow")=e=  [{Release("Steady",d,"pLow")* Energy_Price(d,"
      Contract","pLow")-[(Observed_Rel(d,"pLow")-Release("Steady",d,"pLow"))*Ene
      rgy_Price(d,"Market","pLow")]}*Duration("pLow")*0.03715]* Num_Days("Steady
      ",d);
 374  *****EQ25_Steadydays_Offpeak(d)$(Num_Days("Steady","Sunday") gt 0)..      
        Revenue("Steady",d,"pLow")=e=  [{FlowAtZeroSteadyDays("Steady",d,"pLow")
      * Energy_Price(d,"Contract","pLow") + (Release("Steady",d,"pLow")- FlowAtZ
      eroSteadyDays("Steady",d,"pLow"))*Energy_Price(d,"Market","pLow")}*Duratio
      n("pLow")*0.03715]* Num_Days("Steady",d);
 375   
 376  **I am intentionally making two seperate equations 24 for onpeak and 25 fo
      r offpeak. I want to control both differently and clearly.
 377  *********************Have to identify the case (number of steady days) whe
      n steady low period releases exceed observed releases.
 378   
 379   
 380  EQ26_TotalRevenue..                                                       
                 ObjectiveVal=e= Sum((FlowPattern,d,p),Revenue(FlowPattern,d,p))
      ;
 381   
 382  *-------------------------------------------------------------------------
      -----*
 383   
 384  MODEL Model1 Find value of hydropower revenue using LP/EQ1_ResMassBal,EQ2_
      reqpowerstorage,EQ3_maxstor,EQ4_MaxR,EQ5_MinR,EQ6_ZeroFlowDays,EQ7_Rel_Ran
      ge,
 385  EQ8_AlternativeDays_Relrange,EQ9_AlternativeDays_Relrange,EQ10_Alternative
      Days_Relrange,EQ11_Monthtlyrel,EQ12_RelVolume,EQ13_SteadyFlow_Day,EQ14_Off
      setRel,
 386  EQ15_OnPeak_Saturday,EQ15a_offpeak_Saturday,EQ16_OnPeak_Sunday,EQ16a_offpe
      ak_Sunday,EQ17_Steady_Saturdays,EQ18_Steady_Weekdays,EQ19_OnPeak_UnsteadyD
      ay,
 387  EQ20_EnergyGen_Max,EQ21_EnergyGen,EQ22a_Unsteady_days_Onpeak,EQ22b_Unstead
      y_days_Offpeak,EQ23_Equation,EQ24_Steadydays_Onpeak,EQ25_Steadydays_Offpea
      k,EQ26_TotalRevenue/;
 388  *This model is for all cases of steady flow days. But the results of zero 
      steady low flow days scenario are incorrect so we need seperate model for 
      that.
 389   
 390   
 391  Loop((Offset,tot_vol,Nu_SteadyDays)$(ord(Nu_SteadyDays) gt 1),
 392  *Loop((Offset,tot_vol,Nu_SteadyDays)$((ord(Offset) eq 1)and(ord(tot_vol) e
      q 1)and(ord(Nu_SteadyDays) eq 2) ),
 393   
 394  *FlowAtZeroSteadyDays(FlowType,d,p) = RStore("H1",tot_vol,"Case1",FlowType
      ,d,p);
 395  Weekend_Rel= Diff_Release(Offset);
 396  TotMonth_volume = Vol_monthlyrelease(tot_vol);
 397  Observed_Rel(Days,p)= Nobugflow_Rel(tot_vol,Days,p);
 398  Num_Days(FlowType,Days)= Days_Distribution(FlowType,Days,Nu_SteadyDays)+ E
      PS;
 399   
 400  option LP= CPLEX;
 401   
 402  Solve Model1 using LP MAXIMIZE ObjectiveVal;
 403   
 404  *-------------------------------------------------------------------------
      ---------------------------------------------
 405  *-------------------------------------------------------------------------
      ---------------------------------------------
 406  * All the following lines of code are saving values for different paramete
      rs
 407   
 408    FStore(Offset,tot_vol,Nu_SteadyDays)= ObjectiveVal.L;
 409   
 410  * XStore store the energy generated (Mwh/day) during different types of da
      ys
 411     XStore(Offset,tot_vol,Nu_SteadyDays,FlowType,Days)= sum (p,Energy_Gen.L
      (FlowType,Days,p))+ EPS;
 412   
 413  * RStore store the reservoir releases (cfs) during different types of days
       and scenarios.
 414     RStore(Offset,tot_vol,Nu_SteadyDays,FlowType,Days,p)= Release.L(FlowTyp
      e,Days,p)+ EPS;
 415   
 416  *Sstore store the end of month reservoir storage (ac-ft)
 417     Sstore(Offset,tot_vol,Nu_SteadyDays)= storage.L + EPS;
 418   
 419  Rev(Offset,tot_vol,Nu_SteadyDays,FlowType,Days,p)=  Revenue.L(FlowType,Day
      s,p) +EPS;
 420   
 421  *Saving the model status for different scenarios.
 422     ModelResults(Offset,tot_vol,Nu_SteadyDays,"SolStat")= Model1.solvestat;
 423     ModelResults(Offset,tot_vol,Nu_SteadyDays,"ModStat")= Model1.modelstat;
 424   
 425    option clear=ObjectiveVal,clear=Release,clear=Energy_Gen;
 426  );
 427   
 428   
 429   
 430   
 431  DISPLAY FStore,XStore,RStore,Sstore;
 432   
